# =========================================================
# AutoMarket CI — Environnement de PRODUCTION (backend Laravel)
# Copier ce fichier en .env sur le serveur puis adapter chaque valeur.
# =========================================================

APP_NAME="AchatMarketCI"
APP_ENV=production
APP_KEY=            # générer avec : php artisan key:generate
APP_DEBUG=false
# URL publique de l'API (celle que le frontend appelle)
APP_URL=https://api.votre-domaine.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de données (ex. MySQL/MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automarket
DB_USERNAME=automarket
DB_PASSWORD=CHANGEZ_MOI

# --- Sessions / cache / queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Stockage des photos / avatars (disque local public) ---
FILESYSTEM_DISK=public

# --- E-mail : Brevo (Sendinblue) via SMTP ---
# 1) Créer un compte sur brevo.com
# 2) SMTP & API > SMTP keys > "Generate" (c'est MAIL_PASSWORD)
#    MAIL_USERNAME = l'adresse e-mail du compte Brevo
# 3) Vérifier un expéditeur dans Senders & IP > Senders
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=b47b0b001@smtp-brevo.com
MAIL_PASSWORD=votre-cle-smtp-brevo   # remplacez par la clé SMTP xsmtpsib-...
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bohuegnonzansara@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Code OTP ---
OTP_TTL_MINUTES=10
# OTP_STATIC=          # LAISSER VIDE EN PRODUCTION

# --- CORS : origines autorisées à appeler l'API (séparées par des virgules) ---
# Remplacer par l'URL réelle du frontend (ex. https://achatmarketci.vercel.app)
CORS_ALLOWED_ORIGINS=https://achatmarketci.vercel.app

# --- Sécurité ---
SESSION_SECURE_COOKIE=true
